# Runtime
ENVIRONMENT=local
APP_NAME=Smart Hostel Grievance
API_PREFIX=/api/v1
DEBUG=false

# Database
POSTGRES_DB=smart_hostel
POSTGRES_USER=smart_hostel
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# Production Docker Compose value:
DATABASE_URL=postgresql+psycopg://smart_hostel:replace-with-a-strong-postgres-password@postgres:5432/smart_hostel
# Local lightweight development alternative:
# DATABASE_URL=sqlite:///./data/dev.db
AUTO_CREATE_TABLES=false

# Security
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480
AUTH_COOKIE_NAME=smart_hostel_access_token
SECURE_COOKIES=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
ENABLE_TRANSFORMER_EMBEDDINGS=false
ISSUE_MATCH_THRESHOLD=0.74
DUPLICATE_THRESHOLD=0.88

# Optional OAuth/OIDC
OAUTH_ENABLED=false
OAUTH_PROVIDER_NAME=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_REDIRECT_URI=

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_OAUTH_PROVIDER=
